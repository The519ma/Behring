# Runtime configuration for the prototype middleware flow.
# Keep secrets and hostnames out of the flow JSON.
# Replace only the placeholder values below before testing the live Baserow path.
# The sample-input path can run without live Baserow values.
# BASEROW_TABLE_ID is configured here.
# Baserow row id is not configured here; it is supplied at runtime or read from the source record.

NODE_RED_ENV=development
SOURCE_ADAPTER=baserow_prototype
DESTINATION_ADAPTER=baserow_prototype

# Current prototype adapter
# Insert your real Baserow host URL here.
BASEROW_BASE_URL=http://your-baserow-host:8080
# Insert your real Baserow API token here.
BASEROW_TOKEN=replace_me
# Insert your real Baserow table id here.
BASEROW_TABLE_ID=replace_me

# Optional OpenELIS destination adapter settings
# Use DESTINATION_ADAPTER=openelis_generic_sample_order to forward
# normalized cases into OpenELIS GenericSampleOrder creation.
OPENELIS_BASE_URL=https://replace-with-future-openelis-host.example.com
OPENELIS_SESSION_COOKIE=JSESSIONID=replace_me
OPENELIS_CSRF_TOKEN=replace_me
OPENELIS_GENERIC_SAMPLE_ORDER_PATH=/api/OpenELIS-Global/rest/GenericSampleOrder
OPENELIS_ORDER_SEARCH_PATH=/api/OpenELIS-Global/rest/order/search?accessionNumber=
OPENELIS_HISTOPATHOLOGY_SAMPLE_TYPE_ID=34
OPENELIS_IMMUNOHISTOCHEMISTRY_SAMPLE_TYPE_ID=35

# Reserved for pathology portal, label, and image-link work
BEHRING_PORTAL_BASE_URL=https://replace-with-local-behring-host.example.com
BEHRING_IMAGE_STORAGE_ROOT=/replace/with/local/image/storage/path

# Reserved for future AI draft step
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
